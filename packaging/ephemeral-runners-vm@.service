#
# One VM's QEMU, started by ephemeral-runners-vm.socket for a connection from
# the controller or an image build, and ended with that connection. QEMU
# gets the VM's disks as file descriptors over it, so its user needs no
# access to any of the controller's files, or to other VMs'.

[Unit]
Description=ephemeral-runners VM
Documentation=https://github.com/KnobanLabs/linux-ephemeral-runners#security-model
After=ephemeral-runners-firewall.service
# Never run VMs without the firewall: if it stops, so do they.
BindsTo=ephemeral-runners-firewall.service
CollectMode=inactive-or-failed

[Service]
# The VMs' user, never the controller's. VMs share it, so each one's
# processes, IPC, /tmp and /dev/shm are its own instead (below).
User=ephrunner-vm
Group=ephrunner-vm
SupplementaryGroups=kvm
ExecStart=/usr/local/bin/ephemeral-runners vm
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStopSec=30
# Jobs use idle CPU and disk freely, but when the host is saturated its
# own services get twice the share VMs do (see the slice).
Slice=system-ephemeralrunners.slice
# If the whole host runs out of memory, the kernel kills a job's VM first,
# not the host's own services.
OOMScoreAdjust=500

# QEMU needs /dev/kvm and the descriptors it's given, and nothing else on
# the host.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
InaccessiblePaths=-/etc/ephemeral-runners -/dev/mqueue
TemporaryFileSystem=/dev/shm
# Each VM sees no process but its own: none of the controller's, and none
# of other VMs', which run as the same user. systemd older than 257
# ignores this, with a warning.
PrivatePIDs=yes
PrivateIPC=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
