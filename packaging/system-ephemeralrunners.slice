#
# Every ephemeral-runners VM, job or image build, runs in this slice. Jobs
# use idle CPU and disk freely, but when the host is saturated its own
# services (default weight 100) get twice the share all VMs together do, so
# CI slows down rather than, say, a media server stuttering. To cap the VMs'
# memory below the point where the host runs out, add MemoryMax= a little
# above memory_budget_mb plus an image build's 8 GB (see Capacity in
# README.md).

[Unit]
Description=ephemeral-runners VMs
Documentation=https://github.com/KnobanLabs/linux-ephemeral-runners#capacity
Before=slices.target

[Slice]
CPUWeight=50
IOWeight=50
