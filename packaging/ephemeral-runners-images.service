#
# Rebuilds every golden image the deployments use, from the latest Ubuntu
# cloud image and Actions runner. Started weekly by the timer. New jobs use a
# new image as soon as it's ready; running jobs are unaffected.

[Unit]
Description=Rebuild ephemeral-runners golden images
Documentation=https://github.com/KnobanLabs/linux-ephemeral-runners
Wants=network-online.target
After=network-online.target ephemeral-runners-firewall.service
BindsTo=ephemeral-runners-firewall.service

[Service]
Type=oneshot
User=ephrunner
Group=ephrunner
SupplementaryGroups=kvm
ExecStart=/usr/local/bin/ephemeral-runners -config-dir /etc/ephemeral-runners build-image
# Builds are background work; jobs and the host's own services come first.
Nice=10
CPUWeight=20
IOWeight=20
TimeoutStartSec=3h

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/ephemeral-runners
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0022
