[Unit]
Description=Ephemeral GitHub Actions runners (one QEMU/KVM VM per job)
Documentation=https://github.com/KnobanLabs/linux-ephemeral-runners
Wants=network-online.target ephemeral-runners-vm.socket
After=network-online.target ephemeral-runners-firewall.service ephemeral-runners-vm.socket
# Never run VMs without the firewall: if it stops, so does this.
BindsTo=ephemeral-runners-firewall.service

[Service]
Type=exec
User=ephrunner
Group=ephrunner
ExecStart=/usr/local/bin/ephemeral-runners -config-dir /etc/ephemeral-runners run
Restart=always
RestartSec=30
# Must exceed drain_timeout in host.toml.
TimeoutStopSec=180
# VMs run in units of their own (ephemeral-runners-vm@.service), each
# ending when the controller's connection to it does, so stopping the
# service ends every VM with it.
KillMode=control-group

# The controller needs its config, its state directory and the VM
# launcher's socket, and nothing else on the host.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/ephemeral-runners
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
